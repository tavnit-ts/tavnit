{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["**", "!**/dist", "!**/node_modules", "!**/coverage", "!playground/dist"]
	},
	"linter": {
		"enabled": true,
		"rules": { "preset": "recommended" }
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts", "bench/corpus.mjs", "bench/memory.mjs"],
			"linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
		}
	],
	"formatter": { "enabled": false }
}
